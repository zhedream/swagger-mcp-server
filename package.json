{
  "name": "@zhedream/swagger-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server that parses Swagger (OpenAPI) documents for agents",
  "main": "dist/index.js",
  "bin": {
    "swagger-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "web": "node web/server.js",
    "dev": "npm run build && npm run web",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "swagger",
    "openapi",
    "agent"
  ],
  "author": "zhedream",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhedream/swagger-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/zhedream/swagger-mcp-server/issues"
  },
  "homepage": "https://github.com/zhedream/swagger-mcp-server#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.0",
    "express": "^4.22.2",
    "openapi-types": "^12.1.3",
    "typescript": "^5.9.3",
    "zod": "^4.2.0"
  }
}
