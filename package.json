{
  "name": "swagger-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server that parses Swagger (OpenAPI) documents for agents",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "web": "node web/server.js",
    "dev": "npm run build && npm run web"
  },
  "keywords": [
    "mcp",
    "swagger",
    "openapi",
    "agent"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.0",
    "openapi-types": "^12.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^4.22.2",
    "zod": "^4.2.0"
  }
}
